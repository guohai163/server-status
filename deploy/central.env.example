# PostgreSQL connection URI for a login role that inherits server_status_writer.
SERVER_STATUS_DATABASE_URL=postgres://server_status_app:change-me@postgres.example:5432/server_status_db?sslmode=disable

# Generate each value independently with: openssl rand -hex 32
SERVER_STATUS_ADMIN_TOKEN=
SERVER_STATUS_WEB_ACCESS_KEY=
SERVER_STATUS_LISTEN_ADDR=:8080

# Writable cache for Agent release assets. compose.yaml sets this to its persistent volume mount.
# SERVER_STATUS_RELEASE_CACHE_DIR=/var/cache/server-status

# Set a pinned image that includes dashboard authentication.
SERVER_STATUS_CENTRAL_IMAGE=ghcr.io/guohai163/server-status-central:0.25.0
# SERVER_STATUS_BIND_ADDR=127.0.0.1
