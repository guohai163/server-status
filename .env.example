# 中心镜像版本，保持默认即可。
SERVER_STATUS_VERSION=0.28.0

# 应用绑定的宿主机地址，公网部署时保留回环地址并由 HTTPS 反向代理转发。
SERVER_STATUS_BIND_ADDR=127.0.0.1

# 浏览器或反向代理连接的宿主机端口。
SERVER_STATUS_PORT=8080

# PostgreSQL 初始化和迁移专用密码，运行 openssl rand -hex 32 生成。
SERVER_STATUS_POSTGRES_ADMIN_PASSWORD=

# 应用访问数据库的密码，另运行一次 openssl rand -hex 32 生成。
SERVER_STATUS_DB_PASSWORD=

# 看板登录密码，用户名固定为 viewer，运行 openssl rand -hex 32 生成。
SERVER_STATUS_WEB_ACCESS_KEY=

# 注册节点、编辑配置和导出的管理令牌，独立运行 openssl rand -hex 32 生成。
SERVER_STATUS_ADMIN_TOKEN=
