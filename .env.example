# Public DNS name pointing to this Docker host, such as status.example.com.
SERVER_STATUS_DOMAIN=

# Use a dedicated login role that inherits server_status_writer.
# For example: postgres://server_status_app:URL_ENCODED_PASSWORD@db.internal:5432/server_status_db?sslmode=verify-full
SERVER_STATUS_DATABASE_URL=

# Generate each value independently with: openssl rand -hex 32
SERVER_STATUS_WEB_ACCESS_KEY=
SERVER_STATUS_ADMIN_TOKEN=
